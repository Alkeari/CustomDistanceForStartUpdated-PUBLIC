<?xml version="1.0" encoding="utf-8"?>
<Mod id="aec5ed85-2874-4aa8-a716-e0baf3719caa" version="1">
  <Properties>
    <Name>Custom Distance for Start - Updated</Name>
    <Description>ALL CREDIT goes to Jerzat! I merely made their mod up-to-date. This mod increases the minimum settler spawning distance between civilizations and city states at the start of the game based on your input in advanced settings when creating your game.</Description>
    <Created>1739515713</Created>
    <Teaser>Increases spawning distance for civilizations!</Teaser>
    <Authors>Alkeari</Authors>
    <SpecialThanks>Jerzat</SpecialThanks>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <FrontEndActions>
    <UpdateDatabase id="Settings">
      <File>Config.xml</File>
    </UpdateDatabase>
    <UpdateText id="SettingsLocalization">
      <File>ConfigText.xml</File>
    </UpdateText>
  </FrontEndActions>
  <InGameActions>
    <ImportFiles id="Import">
      <Properties>
        <LoadOrder>100</LoadOrder>
      </Properties>
      <File>Override/AssignStartingPlots.lua</File>
    </ImportFiles>
  </InGameActions>
  <Files>
    <File>Config.xml</File>
    <File>ConfigText.xml</File>
    <File>Override/AssignStartingPlots.lua</File>
  </Files>
</Mod>